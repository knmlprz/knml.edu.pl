# Ustawienia API publikacji. Skopiuj do .env (cp .env.example .env) i uzupełnij.
# Plik .env nie trafia do repo ani do obrazu Docker. Nikomu go nie wysyłaj.
# Skąd wziąć wartości GITHUB_*: README.md, „Faza 5: co ustawia admin organizacji”.

# Adres strony z kreatorem, bez ukośnika na końcu. Tylko stąd API przyjmuje zapytania (CORS)
# i tu wraca po zalogowaniu. Lokalnie: http://localhost:4321 (npm run dev w new-website).
SITE_URL=https://knml.edu.pl

# Publiczny adres tego API, bez ukośnika na końcu. GitHub odsyła tu po zalogowaniu
# (adres API_URL/auth/callback musi być wpisany w ustawieniach aplikacji GitHub jako Callback URL).
API_URL=https://api.knml.edu.pl

# Klucz do podpisywania ciasteczka sesji, min. 32 znaki. Wygeneruj: openssl rand -hex 32
# Zmiana klucza wylogowuje wszystkich.
SESSION_SECRET=

# GitHub App koła (Settings organizacji knmlprz → Developer settings → GitHub Apps).
# App ID ze strony aplikacji.
GITHUB_APP_ID=
# Klucz prywatny aplikacji (plik .pem, „Generate a private key”) w jednej linijce, z \n zamiast
# nowych linii. Zamiana: awk 'NF {printf "%s\\n", $0}' klucz.pem
GITHUB_APP_PRIVATE_KEY=
# Client ID i Client secret tej samej aplikacji (logowanie redakcji przez GitHub).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repo strony, gałąź, do której trafiają wpisy, i zespół z dostępem do kreatora.
# Maintainerzy zespołu są adminami redakcji. Domyślne wartości zwykle zostają.
GITHUB_REPO=knmlprz/knml.edu.pl
GITHUB_BRANCH=main
GITHUB_TEAM=redakcja-strony

# Port w kontenerze. Zmiana wymaga też zmiany w compose.yaml.
PORT=8787
