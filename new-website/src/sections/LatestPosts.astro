---
import { Image } from 'astro:assets';
import MoreLink from '../components/ui/MoreLink.astro';
import Tag from '../components/ui/Tag.astro';
import { latestPosts, postCount } from '../data/site';

const [leadPost, ...sidePosts] = latestPosts;

const formatDate = (date: Date) =>
  date.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<section id="blog" class="container posts" aria-labelledby="h-blog">
  <div class="section-head">
    <h2 id="h-blog" class="section-title">Z życia koła</h2>
    <MoreLink href="/blog">Wszystkie wpisy ({postCount})</MoreLink>
  </div>
  <div class="mosaic">
    <a class="tile tile--lead" href={leadPost.href}>
      <Image src={leadPost.cover} alt="" widths={[640, 960, 1200]} sizes="(min-width: 1000px) 60vw, 100vw" />
      <span class="tile__body">
        <span class="tile__meta">
          <Tag variant="accent">{leadPost.category}</Tag>
          <time datetime={isoDate(leadPost.date)}>{formatDate(leadPost.date)}</time>
        </span>
        <span class="tile__title">{leadPost.title}</span>
        <span class="tile__excerpt">{leadPost.excerpt}</span>
      </span>
    </a>
    <div class="mosaic__side">
      {sidePosts.map((post) => (
        <a class="tile tile--small" href={post.href}>
          <Image src={post.cover} alt="" widths={[480, 800]} sizes="(min-width: 1000px) 35vw, 100vw" />
          <span class="tile__body">
            <span class="tile__meta"><time datetime={isoDate(post.date)}>{formatDate(post.date)}</time> · {post.category}</span>
            <span class="tile__title">{post.title}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .posts { padding-block: 40px clamp(56px, 7vw, 96px); }
  .mosaic { display: flex; flex-wrap: wrap; gap: 16px; }
  .mosaic__side { flex: 1 1 340px; display: flex; flex-direction: column; gap: 16px; }
  .tile { position: relative; overflow: hidden; display: block; border-radius: var(--radius-lg); color: var(--on-photo); text-decoration: none; }
  .tile--lead { flex: 2 1 560px; min-height: 540px; }
  .tile--small { flex: 1 1 262px; min-height: 262px; }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .tile:hover img { transform: scale(1.04); }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--shade) 0%, transparent) 35%, color-mix(in srgb, var(--shade) 88%, transparent) 100%); }
  .tile__body { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .tile--lead .tile__body { padding: clamp(20px, 2.4vw, 32px); gap: 12px; }
  .tile__meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--on-photo-muted); }
  .tile__title { font-size: 21px; line-height: 1.2; font-weight: 600; }
  .tile--lead .tile__title { font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 36px); line-height: 1.12; font-weight: 500; letter-spacing: -0.02em; max-width: 20ch; }
  .tile__excerpt { font-size: 16px; line-height: 1.5; color: var(--on-photo-muted); max-width: 56ch; }

  @media (prefers-reduced-motion: reduce) {
    .tile img { transition: none; }
  }
</style>
