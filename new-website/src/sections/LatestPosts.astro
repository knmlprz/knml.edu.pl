---
import { Image } from 'astro:assets';
import MoreLink from '../components/ui/MoreLink.astro';
import PostTile from '../components/PostTile.astro';
import { t, type Locale } from '../i18n';
import { formatDate, getPosts, isoDate, postUrl } from '../lib/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await getPosts();
// Wpisy są tylko po polsku: w wersji EN karty mają etykietę „In Polish”, a tytuły lang="pl"
// (czytnik ekranu przeczyta je po polsku). Linki prowadzą do polskich wpisów /blog/<slug>/.
const inPolish = locale === 'en' ? t(locale, 'posts.inPolish') : undefined;
const postLang = locale === 'en' ? 'pl' : undefined;
// Najnowszy wpis jest duży i pokazuje excerpt, dwa kolejne są małe.
const [leadPost, ...sidePosts] = posts.slice(0, 3);
---

<section id="blog" class="container posts" aria-labelledby="h-blog">
  <div class="section-head">
    <h2 id="h-blog" class="section-title">{t(locale, 'posts.title')}</h2>
    <MoreLink href="/blog/">{t(locale, 'posts.all')} ({posts.length})</MoreLink>
  </div>
  <div class="mosaic">
    <PostTile
      variant="lead"
      href={postUrl(leadPost)}
      category={t(locale, `category.${leadPost.data.category}`)}
      dateIso={isoDate(leadPost.data.date)}
      dateLabel={formatDate(leadPost.data.date, locale)}
      title={leadPost.data.shortTitle ?? leadPost.data.title}
      excerpt={leadPost.data.excerpt}
      inPolish={inPolish}
      lang={postLang}
    >
      <Image src={leadPost.data.cover} alt="" widths={[640, 960, 1200]} sizes="(min-width: 1000px) 60vw, 100vw" />
    </PostTile>
    <div class="mosaic__side">
      {sidePosts.map((post) => (
        <PostTile
          variant="small"
          href={postUrl(post)}
          category={t(locale, `category.${post.data.category}`)}
          dateIso={isoDate(post.data.date)}
          dateLabel={formatDate(post.data.date, locale)}
          title={post.data.shortTitle ?? post.data.title}
          inPolish={inPolish}
          lang={postLang}
        >
          <Image src={post.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 1000px) 35vw, 100vw" />
        </PostTile>
      ))}
    </div>
  </div>
</section>

<style>
  .posts { padding-block: 40px clamp(56px, 7vw, 96px); }
  .mosaic { display: flex; flex-wrap: wrap; gap: 16px; }
  .mosaic__side { flex: 1 1 340px; display: flex; flex-direction: column; gap: 16px; }
</style>
