---
import KnmlLogo from '../components/KnmlLogo.astro';
import ArrowIcon from '../components/ui/ArrowIcon.astro';
import Button from '../components/ui/Button.astro';
import { joinUrl } from '../data/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Kroki do potwierdzenia przez zarząd (TODO.md).
const steps = [t(locale, 'join.step1'), t(locale, 'join.step2'), t(locale, 'join.step3')];
---

<section id="dolacz" class="join-wrap on-dark" aria-labelledby="h-join">
  <div class="join">
    <KnmlLogo class="join__bg-logo" />
    <div class="join__in">
      <div class="join__text">
        <span class="join__eyebrow">{t(locale, 'join.eyebrow')}</span>
        <h2 id="h-join">{t(locale, 'join.title')}</h2>
        <p class="join__lead">{t(locale, 'join.lead')}</p>
        <div class="join__cta">
          <Button href={joinUrl} variant="highlight">{t(locale, 'joinUs')} <ArrowIcon /></Button>
          <Button href="#kontakt" variant="ghostDark">{t(locale, 'join.writeToUs')}</Button>
        </div>
      </div>
      <ol class="steps">
        {steps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .join-wrap { padding: clamp(32px, 4vw, 56px) var(--gutter) 0; }
  .join { position: relative; overflow: hidden; max-width: var(--container); margin: 0 auto; background: var(--color-brand); color: var(--bg); border-radius: var(--radius-xl); }
  .join :global(.join__bg-logo) { position: absolute; right: -4%; top: 50%; transform: translateY(-50%); width: min(560px, 60vw); height: auto; color: color-mix(in srgb, var(--color-accent) 14%, transparent); }
  .join__in { position: relative; padding: clamp(48px, 7vw, 96px) clamp(24px, 5vw, 72px); display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6vw, 96px); align-items: flex-end; }
  .join__text { flex: 3 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .join__eyebrow { font-size: 15px; font-weight: 600; color: var(--color-accent); }
  h2 { margin: 0; font-family: var(--font-display); font-size: var(--h-join); line-height: .92; font-weight: 600; letter-spacing: -0.045em; }
  .join__lead { margin: 0; max-width: 48ch; font-size: 19px; line-height: 1.5; color: var(--on-dark-soft); }
  .join__cta { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px; }
  .join__cta :global(.btn) { height: 58px; padding-inline: 30px; }
  .steps { flex: 2 1 320px; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; counter-reset: step; }
  .steps li { display: flex; gap: 16px; align-items: center; padding: 16px 18px; background: color-mix(in srgb, var(--on-brand) 7%, transparent); border-radius: 18px; font-size: 18px; font-weight: 600; line-height: 1.3; counter-increment: step; }
  .steps li::before { content: counter(step); flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; background: var(--color-highlight); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 13px; font-weight: 600; }
</style>
