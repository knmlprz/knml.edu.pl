---
import { Image } from 'astro:assets';
import MoreLink from '../components/ui/MoreLink.astro';
import Tag from '../components/ui/Tag.astro';
import { featuredProjects } from '../data/site';
---

<section id="projekty" class="container projects" aria-labelledby="h-proj">
  <div class="section-head">
    <h2 id="h-proj" class="section-title">Projekty</h2>
    <MoreLink href="/projekty">Wszystkie projekty</MoreLink>
  </div>
  <div class="proj-grid">
    {featuredProjects.map((project) => {
      const [category, ...tags] = project.tags;
      return (
        <a class="proj" href={project.href}>
          <div class="proj__img">
            <Image src={project.cover} alt="" widths={[640, 960, 1200]} sizes="(min-width: 1100px) 50vw, 100vw" />
          </div>
          <div class="proj__body">
            <div class="proj__tags">
              <Tag variant="accent">{category}</Tag>
              {tags.map((tag) => <Tag>{tag}</Tag>)}
            </div>
            <span class="proj__title">{project.title}</span>
            <span class="proj__desc">{project.description}</span>
            <span class="proj__meta">{project.meta}</span>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .projects { padding-block: clamp(56px, 7vw, 96px); }
  .proj-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr)); gap: 20px; }
  .proj { display: flex; flex-direction: column; gap: 18px; padding: 12px 12px 24px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); text-decoration: none; color: var(--ink); transition: box-shadow .25s, transform .25s; }
  .proj:hover { box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--shade) 35%, transparent); transform: translateY(-3px); }
  .proj__img { aspect-ratio: 16 / 9; border-radius: var(--radius-md); overflow: hidden; background: var(--section); }
  .proj__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .proj:hover .proj__img img { transform: scale(1.04); }
  .proj__body { padding: 0 12px; display: flex; flex-direction: column; gap: 14px; }
  .proj__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .proj__title { font-family: var(--font-display); font-size: clamp(22px, 2vw, 28px); line-height: 1.15; font-weight: 500; letter-spacing: -0.02em; }
  .proj__desc { font-size: 16px; line-height: 1.55; color: var(--body-2); max-width: 60ch; }
  .proj__meta { font-size: 14px; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    .proj, .proj__img img { transition: none; }
  }
</style>
