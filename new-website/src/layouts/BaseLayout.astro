---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/geist';
import '../styles/tokens.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocale, homeUrl, t } from '../i18n';
import { getPartners } from '../lib/partners';

interface Props {
  title?: string;
  description?: string;
  /** Obrazek podglądu linku (Open Graph). Bez niego: public/og-default.png. */
  image?: ImageMetadata;
  /** 'article' dla wpisów na blogu. */
  type?: 'website' | 'article';
  /** Strona, której wyszukiwarki nie mają indeksować (np. 404). */
  noindex?: boolean;
}

const locale = getLocale(Astro);
const siteName = t(locale, 'siteName');
const {
  title = t(locale, 'seo.title'),
  description = t(locale, 'seo.description'),
  image,
  type = 'website',
  noindex = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
// 1200×630 to format podglądu linku (okładki bywają pionowe, więc przycinamy).
// JPEG zamiast WebP, bo nie każdy serwis (np. starsze podglądy w komunikatorach) czyta WebP.
const ogImagePath = image
  ? (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src
  : '/og-default.png';
const ogImageUrl = new URL(ogImagePath, Astro.site);
const partners = await getPartners(locale);
// Tłumaczenie ma dziś tylko strona główna, więc tylko ona wskazuje swoją drugą wersję językową.
const isHome = Astro.url.pathname === homeUrl(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    {isHome && <link rel="alternate" hreflang="pl" href={new URL(homeUrl('pl'), Astro.site)} />}
    {isHome && <link rel="alternate" hreflang="en" href={new URL(homeUrl('en'), Astro.site)} />}
    {isHome && <link rel="alternate" hreflang="x-default" href={new URL(homeUrl('pl'), Astro.site)} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'pl_PL'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skipLink')}</a>
    <SiteHeader locale={locale} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter partners={partners} locale={locale} />
  </body>
</html>
