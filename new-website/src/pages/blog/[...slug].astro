---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/post.css';
import MoreLink from '../../components/ui/MoreLink.astro';
import Tag from '../../components/ui/Tag.astro';
import { getLocale, t } from '../../i18n';
import { formatDate, getPosts, isoDate, postDescription, tagUrl, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, date, author, category, tags, cover, coverAlt, githubLink } = post.data;
const { Content } = await render(post);
const locale = getLocale(Astro);
---

<BaseLayout title={`${title} - KNML`} description={postDescription(post)} image={cover} type="article">
  <article class="container article">
    <header class="article__head">
      <p class="article__meta">
        <Tag variant="accent">{t(locale, `category.${category}`)}</Tag>
        <time datetime={isoDate(date)}>{formatDate(date, locale)}</time>
        <span>{author}</span>
      </p>
      <h1 class="article__title">{title}</h1>
      {tags.length > 0 && (
        <ul class="article__tags" aria-label="Tagi">
          {tags.map((tag) => <li><a href={tagUrl(tag)}>#{tag}</a></li>)}
        </ul>
      )}
    </header>

    <Image class="article__cover" src={cover} alt={coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 960px) 900px, 100vw" loading="eager" />

    <div class="prose">
      <Content />
    </div>

    {githubLink && <p class="article__github"><a href={githubLink}>Kod na GitHubie ↗</a></p>}

    <MoreLink href="/blog/">Wszystkie wpisy</MoreLink>
  </article>
</BaseLayout>
