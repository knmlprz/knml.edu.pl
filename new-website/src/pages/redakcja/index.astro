    display: grid; grid-template-columns: 96px 1fr; gap: 14px; padding: 12px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md);
  }
  .images :global(.image__thumb img), .images :global(.image__thumb .heic-tile) { width: 96px; height: 96px; object-fit: cover; border-radius: var(--radius-sm); }
  .images :global(.image__thumb .heic-tile) { padding: 6px; font-size: 11px; }
  .images :global(.image__body) { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .images :global(.image__name) { margin: 0; font-size: 14px; color: var(--muted); overflow-wrap: anywhere; }
  .images :global(.image__cover) { display: inline-flex; padding: 2px 10px; border-radius: var(--radius-pill); background: var(--color-accent); color: var(--ink); font-weight: 600; }
