  }
  .choice:has(input:checked) { background: var(--color-brand); color: var(--on-brand); }
  .choice:has(input:focus-visible) { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  .choice input { accent-color: var(--color-brand); width: 18px; height: 18px; margin: 0; }

