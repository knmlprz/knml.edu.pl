  @media (max-width: 480px) {
    .images :global(.image) { grid-template-columns: 1fr; }
  }

  .check { padding: 16px 20px; border-radius: var(--radius-md); background: var(--section); }
  .check__title { margin: 0; font-size: 17px; }
  .check ul { margin: 10px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; line-height: 1.5; }
  .check--ok ul { display: none; }

  .button[hidden] { display: none; }

  .account { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 32px; padding: 16px 20px; border-radius: var(--radius-md); background: var(--section); }
  .account__text { flex: 1 1 260px; margin: 0; font-size: 15px; line-height: 1.5; }
  a.button { text-decoration: none; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .status { font-size: 15px; line-height: 1.5; overflow-wrap: anywhere; }
  .status:empty { display: none; }

  .preview { margin-top: 32px; border-top: 1px solid var(--line); padding-top: 32px; }
  .preview__title { margin: 0 0 6px; font-family: var(--font-display); font-weight: 500; font-size: 24px; }
  .preview :global(.heic-tile) { display: flex; width: 100%; aspect-ratio: 3 / 2; margin-bottom: 36px; }
  .preview :global(.prose .heic-tile) { margin: 1.5em 0 0.5em; }
  .preview__tiles { display: flex; flex-wrap: wrap; gap: 32px; padding-bottom: clamp(56px, 7vw, 96px); }
  .preview__tiles > div { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .preview__tiles > div:first-child { flex: 1 1 300px; max-width: 440px; }
  .preview__tiles > div:last-child { flex: 2 1 320px; }
  .preview__subtitle { margin: 0; font-size: 16px; font-weight: 600; }
  /* Kafelek bez okładki (jeszcze nie dodana albo HEIC): ciemne tło, żeby jasny tekst był czytelny. */
  .preview__tile { border-radius: var(--radius-lg); background: var(--shade); }
</style>
