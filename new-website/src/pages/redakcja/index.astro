  .suggestion:hover { text-decoration: underline; }
  .badge { padding: 2px 8px; border-radius: var(--radius-pill); background: var(--color-accent); color: var(--ink); font-size: 12px; font-weight: 600; }
  .badge[hidden] { display: none; }
  .tag-entry { display: flex; gap: 8px; }
  .tag-entry input { flex: 1; min-width: 0; }
  .counter { text-align: right; }

  .toolbar { display: flex; flex-wrap: wrap; gap: 6px; }
  .toolbar__button, .button {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 16px;
    font: inherit; font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer;
    background: var(--surface); border: 1.5px solid var(--line-strong); border-radius: var(--radius-pill);
  }
  .toolbar__button[aria-pressed='true'] { background: var(--color-brand); border-color: var(--color-brand); color: var(--on-brand); }
  .button:disabled { opacity: 0.4; cursor: default; }
  .button--primary { min-height: 52px; padding: 0 26px; font-size: 17px; background: var(--color-brand); border-color: var(--color-brand); color: var(--on-brand); }
  .button--primary:hover { filter: brightness(1.15); }
  .button--small { padding: 0 14px; }

  .editor :global(.editor__content) {
    min-height: 240px; padding: 4px 16px; font-size: 17px;
    background: var(--surface); border: 1.5px solid var(--line-strong); border-radius: var(--radius-sm);
  }
  .editor :global(.editor__content h2:first-child) { margin-top: 0.6em; }

  .dropzone {
    display: flex; align-items: center; justify-content: center; min-height: 96px; padding: 16px;
    border: 2px dashed var(--placeholder-line); border-radius: var(--radius-md);
    color: var(--ink-2); font-weight: 600; text-align: center; cursor: pointer;
  }
  .dropzone:focus-within, .dropzone--over { border-color: var(--color-brand); background: var(--section); }
  .dropzone:focus-within { outline: 2px solid var(--color-brand); outline-offset: 2px; }

