---
// Siatka kart wpisów: lista /blog/ i strony tagów /tags/<tag>/.
import { Image } from 'astro:assets';
import Tag from './ui/Tag.astro';
import { t, type Locale } from '../i18n';
import { formatDate, isoDate, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  locale: Locale;
}

const { posts, locale } = Astro.props;
---

<ul class="post-grid">
  {posts.map((post) => (
    <li>
      <a class="post" href={postUrl(post)}>
        <div class="post__img">
          <Image src={post.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw" />
        </div>
        <div class="post__body">
          <span class="post__meta">
            <Tag variant="accent">{t(locale, `category.${post.data.category}`)}</Tag>
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, locale)}</time>
          </span>
          <span class="post__title">{post.data.title}</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .post-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 20px; }
  .post { height: 100%; display: flex; flex-direction: column; gap: 16px; padding: 12px 12px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); text-decoration: none; color: var(--ink); transition: box-shadow .25s, transform .25s; }
  .post:hover { box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--shade) 35%, transparent); transform: translateY(-3px); }
  .post__img { aspect-ratio: 16 / 9; border-radius: var(--radius-md); overflow: hidden; background: var(--section); }
  .post__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .post:hover .post__img img { transform: scale(1.04); }
  .post__body { padding: 0 10px; display: flex; flex-direction: column; gap: 12px; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 14px; color: var(--muted); }
  .post__title { font-size: 19px; line-height: 1.3; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    .post, .post__img img { transition: none; }
  }
</style>
