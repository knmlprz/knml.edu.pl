---
// Siatka kart wpisów: lista /blog/ i strony tagów /tags/<tag>/.
import { Image } from 'astro:assets';
import PostCard from './PostCard.astro';
import { t, type Locale } from '../i18n';
import { formatDate, isoDate, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  locale: Locale;
}

const { posts, locale } = Astro.props;
---

<ul class="post-grid">
  {posts.map((post) => (
    <li>
      <PostCard
        href={postUrl(post)}
        category={t(locale, `category.${post.data.category}`)}
        dateIso={isoDate(post.data.date)}
        dateLabel={formatDate(post.data.date, locale)}
        title={post.data.title}
      >
        <Image src={post.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw" />
      </PostCard>
    </li>
  ))}
</ul>

<style>
  .post-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 20px; }
</style>
