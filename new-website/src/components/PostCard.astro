---
// Karta wpisu: lista /blog/ i strony tagów (przez PostGrid) oraz podgląd w kreatorze /redakcja/.
// Okładka przychodzi przez <slot />, bo kreator wstawia ją dopiero w przeglądarce.
import Tag from './ui/Tag.astro';

interface Props {
  /** Bez adresu (podgląd w kreatorze) karta nigdzie nie prowadzi. */
  href?: string;
  category: string;
  dateIso?: string;
  dateLabel: string;
  title: string;
}

const { href, category, dateIso, dateLabel, title } = Astro.props;
---

<a class="post" href={href}>
  <div class="post__img"><slot /></div>
  <div class="post__body">
    <span class="post__meta">
      <Tag variant="accent">{category}</Tag>
      <time datetime={dateIso}>{dateLabel}</time>
    </span>
    <span class="post__title">{title}</span>
  </div>
</a>

<style>
  .post { height: 100%; display: flex; flex-direction: column; gap: 16px; padding: 12px 12px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); text-decoration: none; color: var(--ink); transition: box-shadow .25s, transform .25s; }
  .post[href]:hover { box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--shade) 35%, transparent); transform: translateY(-3px); }
  .post__img { aspect-ratio: 16 / 9; border-radius: var(--radius-md); overflow: hidden; background: var(--section); }
  /* :global, bo zdjęcie przychodzi ze slotu (albo z kreatora) i nie ma atrybutu tego komponentu. */
  .post__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .post[href]:hover .post__img :global(img) { transform: scale(1.04); }
  .post__body { padding: 0 10px; display: flex; flex-direction: column; gap: 12px; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 14px; color: var(--muted); }
  .post__title { font-size: 19px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }

  @media (prefers-reduced-motion: reduce) {
    .post, .post__img :global(img) { transition: none; }
  }
</style>
