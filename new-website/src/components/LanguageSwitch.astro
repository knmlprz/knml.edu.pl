---
// „PL / EN” w nagłówku, aktywny język pogrubiony. Wersja EN ma dziś tylko stronę główną,
// więc każda polska strona (blog, tagi, 404) prowadzi do /en/, a angielska do /.
import { homeUrl, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
---

<a class:list={['lang-switch', className]} href={homeUrl(otherLocale)} hreflang={otherLocale} aria-label={t(locale, 'header.switchLanguage')}>
  <span class:list={{ 'lang-switch__active': locale === 'pl' }}>PL</span>
  <span aria-hidden="true">/</span>
  <span class:list={{ 'lang-switch__active': locale === 'en' }}>EN</span>
</a>

<style>
  .lang-switch { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 44px; min-height: 44px; padding: 0 12px; font-size: 15px; font-weight: 500; color: var(--muted); text-decoration: none; border-radius: var(--radius-pill); }
  .lang-switch:hover { background: var(--nav-hover-bg); }
  .lang-switch__active { color: var(--ink); font-weight: 700; text-decoration: underline 3px var(--color-accent); text-underline-offset: 6px; }
</style>
